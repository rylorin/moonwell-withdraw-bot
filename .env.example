# Moonwell withdraw bot — configuration
# Copier ce fichier en `.env` puis remplir les valeurs.

# --- Obligatoire ---

# URL WebSocket Alchemy pour Base (wss://base-mainnet.g.alchemy.com/v2/VOTRE_CLE_ALCHEMY). Servira aux souscriptions de
# blocs et à la soumission des transactions.
BASE_WSS_URL=PASTE_YOUR_WSS_URL_HERE

# Clé privée du wallet (commence par 0x). NE JAMAIS PARTAGER NI COMMITTER.
PRIVATE_KEY=PASTE_YOUR_PRIVATE_KEY_HERE

# --- Optionnel (avec valeurs par défaut) ---

# Moonwell mUSDC contract on Base
# MUSDC_ADDRESS=0xEdc817A28E8B93B03976FBd4a3dDBc9f7D176c22

# RPC public pour les lectures getCash() fréquentes (gratuit, pas d'inscription).
# DRPC gère le taux de lecture pour ne pas surcharger la connexion Alchemy.
# BASE_READ_RPC_URL=https://base.drpc.org

# Montant total à retirer en USDC (unités humaines). Si absent, retire le
# solde décomposable complet.
# WITHDRAW_AMOUNT=70000

# Montant minimum par chunk en USDC — en dessous, le bot saute le tour.
# MIN_CHUNK=5

# Relecture périodique du solde décomposable (en secondes) pour détecter les
# changements externes (dépôts, retraits manuels, intérêts). 0 = désactivé.
# BALANCE_MONITOR_INTERVAL=60

# Source du plafond de chaque chunk : `monitor` (dernière valeur lue par le
# moniteur de balance, par défaut) ou `fresh` (relecture du solde à chaque
# tour via le RPC de lecture). En mode solde complet (sans WITHDRAW_AMOUNT)
# le solde connu sert aussi de cible à atteindre.
# CHUNK_CAP_SOURCE=monitor
