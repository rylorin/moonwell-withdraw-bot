{
  "name": "moonwell-withdraw-bot",
  "version": "0.0.7",
  "description": "Bot Node.js pour retirer des USDC de Moonwell (Base) en plusieurs chunks selon la liquidité disponible",
  "author": "weez2",
  "main": "moonwell-withdraw-bot-chunked.js",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "NODE_ENV=development tsx src/moonwell-withdraw-bot-chunked",
    "start": "node ./dist/moonwell-withdraw-bot-chunked.js",
    "test": "yarn build && node --test",
    "check": "node --check moonwell-withdraw-bot-chunked.js"
  },
  "keywords": [
    "moonwell",
    "base",
    "usdc",
    "withdraw",
    "defi",
    "ethereum",
    "compound"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
