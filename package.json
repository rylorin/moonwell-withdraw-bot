{
  "name": "moonwell-withdraw-bot",
  "version": "0.0.18",
  "description": "Bot Node.js pour retirer des USDC de Moonwell (Base) en plusieurs chunks selon la liquidité disponible",
  "author": "weez2",
  "main": "./dist/moonwell-withdraw-bot-chunked.js",
  "packageManager": "yarn@1.22.22",
  "bin": {
    "moonwell-withdraw-bot": "dist/moonwell-withdraw-bot-chunked.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "NODE_ENV=development tsx --watch src/moonwell-withdraw-bot-chunked",
    "start": "node ./dist/moonwell-withdraw-bot-chunked.js",
    "test": "yarn build && node --test",
    "qc": "prettier --check ./src && tsc --noEmit && yarn test"
  },
  "keywords": [
    "moonwell",
    "base",
    "usdc",
    "withdraw",
    "defi",
    "ethereum",
    "compound"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-multi-stream": "^6.0.0",
    "pino-pretty": "^13.1.3",
    "pino-rotate": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pino": "^7.0.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
